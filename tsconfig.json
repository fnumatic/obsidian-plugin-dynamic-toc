{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "es6",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2019"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "allowJs": true,
    "importHelpers": true
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "archive"
  ]
}
